# ============================================
# FAIPCO Portal - نمونه تنظیمات محیطی
# این فایل را کپی کنید به .env و مقادیر واقعی را وارد کنید
# دستور کپی: cp .env.example .env
# ============================================

APP_NAME=FAIPCO Portal
APP_ENV=development
# برای دیدن مستندات تعاملی API (Swagger در /api/docs)، این باید true باشد —
# در Production واقعی (که install.sh خودش .env جداگانه می‌سازد، نه این فایل)
# همیشه false است، چون مستندات کامل API را بدون نیاز به ورود در اختیار
# هرکسی می‌گذارد.
DEBUG=true

# دیتابیس اصلی Portal (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://faipco_user:CHANGE_ME@localhost:5432/faipco_portal

# با دستور زیر تولید کنید: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# با دستور زیر تولید کنید:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DB_CREDENTIALS_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_FERNET

CORS_ORIGINS=["http://localhost:3000"]

# آدرس Frontend - برای ساخت لینک‌های ایمیل (مثل بازنشانی رمز عبور)
FRONTEND_URL=http://localhost:3000

SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=30
